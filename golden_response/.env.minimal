# ============================================================================
# MINIMAL .env FOR QUICK START
# ============================================================================
# Copy this to .env and just set GOOGLE_API_KEY to get started!
# The rest have sensible defaults that work with docker-compose.
# ============================================================================

# ─── REQUIRED: Get your free API key from https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your-google-ai-studio-api-key

# ─── OPTIONAL: Change these if you want (defaults work fine for development)
POSTGRES_PASSWORD=devpass123
REDIS_PASSWORD=devpass123
JWT_SECRET_KEY=dev-jwt-secret-key-min-32-chars-for-development-only
APP_SECRET_KEY=dev-app-secret-key-min-32-chars-for-development-only

# ============================================================================
# That's it! Everything else uses defaults from backend/config.py
# ============================================================================
